# ---------------------------------------------------------------------------
# Environment template. Copy to `.env.local` and fill in.
#
# Copy with:  cp .env.example .env.local
# ---------------------------------------------------------------------------

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# REQUIRED, server-side only. Never expose this: it bypasses Row Level Security.
# Missing/incorrect values now fail loudly instead of silently falling back to
# the anon key (see PRODUCTION_READINESS.md B7).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# ZKTeco terminal (ADMS push protocol) authentication — REQUIRED  (B4)
#
# The terminal endpoints /iclock/cdata, /iclock/getrequest and /iclock/devicecmd
# are public write paths into the database. They are refused (503) unless this
# token is set, and every request must present it as `?token=`, an
# `X-ADMS-Token` header, or `Authorization: Bearer`.
#
# Commission the terminal with:
#   Server address: https://your-domain.com/iclock?token=THE_SAME_VALUE
#   Server port:    443  (or 8088 for the plain-HTTP rewrite)
#
# Generate one with:  openssl rand -hex 32
ADMS_SECRET_TOKEN=

# TEMPORARY MIGRATION FLAG — leave unset.
# Set to `true` only while cutting a terminal over to the token above. Every
# request is logged as unauthenticated while it is on, and it must be removed
# from production as soon as the terminal sends the token.
# ADMS_ALLOW_UNCONFIGURED=true

# ---------------------------------------------------------------------------
# Cron (Vercel -> /api/cron/monthly-reports) — REQUIRED  (B8)
#
# Vercel injects `Authorization: Bearer $CRON_SECRET` on cron invocations when
# this variable is set on the project. Without it the endpoint answers 503, so a
# missing value can no longer turn the URL into a public mass-mailer.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Email delivery (report automation). Resend is preferred; SMTP is the fallback.
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM=Dawar Al-Saada Attendance <onboarding@resend.dev>

# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=Dawar Al-Saada Attendance <your-email@gmail.com>

# Web push (optional)
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
